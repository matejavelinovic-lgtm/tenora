---
// One page per leadership-team member, from src/content/team/<slug>.md.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const team = await getCollection('team');
  return team.map((member) => ({ params: { slug: member.id }, props: { member } }));
}

const { member } = Astro.props;
const { name, role, photo, linkedin } = member.data;
const bio = (member.body ?? '').trim();
---

<Layout theme="light" tight title="Tenora leadership" description="Tenora team member">
  <section class="about-hero">
    <div class="pricing-hero-container">
      <div class="pricing-hero-inner">
        <div class="member-grid">
          <div class="member-photo-box reveal"><img class="member-photo" src={photo} alt={name} width="300" height="355" /></div>
          <div class="member-body">
            <div class="member-wrap reveal">
              <div class="member-heading">
                <div><p class="eyebrow">{role}</p></div>
                <h1 class="member-name">{name}</h1>
                <div class="member-bio">{bio}</div>
                {linkedin && <div class="member-actions"><a class="btn btn-outline" href={linkedin} target="_blank" rel="noopener">Visit LinkedIn</a></div>}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
