---
// Dark band: sticky heading on the left, a rail of glass cards on the right.
import Icon from './Icon.astro';
interface Card { icon?: string; eyebrow?: string; title: string; text: string; href?: string; cta?: string }
interface Props { eyebrow: string; title: string; text: string; cta?: string; href?: string; cards: Card[] }
const { eyebrow, title, text, cta, href, cards } = Astro.props;
---

<section class="timeline">
  <div class="timeline-inner">
    <div class="timeline-layout">
      <div class="timeline-aside reveal">
        <div class="timeline-sticky">
          <div class="section-heading reveal">
            <p class="eyebrow">{eyebrow}</p>
            <h2 class="h2 h2-light">{title}</h2>
            <p class="lead lead-light">{text}</p>
            {cta && <a class="btn btn-primary feature-btn" href={href}>{cta}</a>}
          </div>
        </div>
      </div>
      <div class="timeline-track reveal">
        <div class="timeline-rail"></div>
        <div class="timeline-cards">
          {cards.map((t) => (
            <div class="glass-card">
              <div class="glass-card-body">
                {t.icon ? <Icon name={t.icon} class="icon-box" /> : <p class="eyebrow">{t.eyebrow}</p>}
                <h3 class="glass-card-title">{t.title}</h3>
                <p class="glass-card-text">{t.text}</p>
              </div>
              {t.href && (
                <div class="glass-card-actions">
                  <a class="btn btn-outline btn-fixed" href={t.href}>{t.cta ?? 'Learn More'}</a>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
