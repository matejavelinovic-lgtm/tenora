---
// Tile with a dashed vertical rule and green accent, optional icon tile.
import Icon from './Icon.astro';
interface Props { title: string; text: string; icon?: string }
const { title, text, icon } = Astro.props;
---

<div class="gov-tile reveal">
  <div class="gov-line">
    <Icon name="divider-vertical" class="gov-divider" />
    <div class="gov-accent"></div>
  </div>
  <div class="gov-content">
    {icon && <Icon name={icon} class="gov-icon" />}
    <div class="gov-copy">
      <h3 class="h4">{title}</h3>
      <p class="gov-text">{text}</p>
    </div>
  </div>
</div>
