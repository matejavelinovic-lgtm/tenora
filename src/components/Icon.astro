---
// Inlines an SVG from src/icons/<name>.svg so it inherits colour and sizes
// like the original's embedded icons.
interface Props { name: string; class?: string }
const { name, class: className } = Astro.props;
const icons = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const svg = icons[`../icons/${name}.svg`];
if (!svg) throw new Error(`Icon not found: ${name}`);
---
<span class={className} set:html={svg} />
